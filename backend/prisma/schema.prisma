// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  senhaHash             String    @map("senha_hash")
  nome                  String?
  dataNascimento        DateTime? @map("data_nascimento")
  telefone              String? // Telefone com máscara
  plano                 String? // MENSAL, TRIMESTRAL, SEMESTRAL
  planoAtivo            Boolean   @default(false) @map("plano_ativo")
  dataPagamento         DateTime? @map("data_pagamento")
  dataExpiracao         DateTime? @map("data_expiracao") // Data de expiração do plano
  dataInicioTrial       DateTime? @map("data_inicio_trial") // Data de início do trial
  dataFimTrial          DateTime? @map("data_fim_trial") // Data de fim do trial (3 dias após início)
  trialUtilizado        Boolean   @default(false) @map("trial_utilizado") // Flag para garantir apenas um trial por email
  whatsappOptIn         Boolean   @default(false) @map("whatsapp_opt_in") // Consentimento WhatsApp
  whatsappOptInDate     DateTime? @map("whatsapp_opt_in_date") // Data do consentimento
  whatsappPhoneNumber   String?   @unique @map("whatsapp_phone_number") // Número WhatsApp (E.164 format)
  caktoCustomerId       String?   @map("cakto_customer_id") // ID do cliente no Cakto
  caktoTransactionId    String?   @map("cakto_transaction_id") // ID da última transação
  modoTreino            String?   @default("IA") @map("modo_treino") // "IA" ou "MANUAL"
  currentTrainingSource String?   @map("current_training_source") // "IA" ou "MANUAL"
  currentTrainingId     String?   @map("current_training_id") // UUID do treino ativo
  role                  Role      @default(USER)
  ativo                 Boolean   @default(true) // Soft delete - usuários desabilitados não aparecem na listagem
  perfil                Perfil?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relacionamentos
  historicoPesos                 HistoricoPeso[]
  treinos                        Treino[]
  refreshTokens                  RefreshToken[]
  treinosPersonalizadosTemplates TreinoPersonalizadoTemplate[]
  configuracoesTreino            ConfiguracaoTreinoUsuario[]
  paymentHistory                 PaymentHistory[]
  passwordResetTokens            PasswordResetToken[]
  remarketingEmails              RemarketingEmail[]
  whatsappConversations          WhatsAppConversation[]
  whatsappCadence                WhatsAppCadence?
  whatsappMessages               WhatsAppMessageLog[]
  adminAuditLogs                 AdminAuditLog[]

  @@map("users")
}

model Perfil {
  id                         String    @id @default(uuid())
  userId                     String    @unique @map("user_id")
  idade                      Int?
  sexo                       String?
  tipoCorpo                  String?   @map("tipo_corpo") // Ectomorfo, Mesomorfo, Endomorfo (masculino) | Em Forma, Sobrepeso, Acima do Peso, Obesidade (feminino)
  altura                     Float? // em cm
  pesoAtual                  Float?    @map("peso_atual") // em kg
  percentualGordura          Float?    @map("percentual_gordura")
  aguaDiaria                 String?   @map("agua_diaria") // Consumo diário de água
  experiencia                String? // Iniciante, Intermediário, Avançado
  objetivo                   String? // Emagrecimento, Hipertrofia, Força, Condicionamento
  frequenciaSemanal          Int?      @map("frequencia_semanal")
  tempoDisponivel            Int?      @map("tempo_disponivel") // em minutos
  localTreino                String?   @map("local_treino") // Casa, Academia, Misto
  problemasAnteriores        String[]  @map("problemas_anteriores") // Problemas em tentativas anteriores de condicionamento físico
  objetivosAdicionais        String[]  @map("objetivos_adicionais") // Objetivos adicionais de estilo de vida
  lesoes                     String[] // array de strings
  equipamentos               String[] // array de strings - DEPRECATED, será removido
  preferencias               String[] // array de strings
  rpePreferido               Int?      @map("rpe_preferido")
  ultimaAtualizacaoPeriodica DateTime? @map("ultima_atualizacao_periodica") // Data da última atualização periódica (a cada 30 dias)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("perfis")
}

model HistoricoPeso {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  peso      Float // em kg
  data      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, data])
  @@map("historico_pesos")
}

model Treino {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  data           DateTime
  tipo           String
  concluido      Boolean  @default(false)
  tempoEstimado  Int?     @map("tempo_estimado") // em minutos
  criadoPor      String   @default("IA") @map("criado_por") // "IA" ou "USUARIO"
  nome           String // Nome obrigatório para treinos personalizados
  templateId     String?  @map("template_id") // ID do template usado (se aplicável)
  diaSemana      Int?     @map("dia_semana") // 0=domingo, 1=segunda, etc. Para treinos recorrentes
  recorrente     Boolean  @default(false) // Se é treino recorrente (A-G)
  letraTreino    String?  @map("letra_treino") // A, B, C, D, E, F ou G
  primeiraSemana Boolean  @default(false) @map("primeira_semana") // Se é treino da primeira semana (coleta de dados)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercicios            ExercicioTreino[]
  templatePersonalizado TreinoPersonalizadoTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, data])
  @@index([userId, data, concluido])
  @@index([criadoPor])
  @@map("treinos")
}

model Exercicio {
  id                     String   @id @default(uuid())
  nome                   String
  grupoMuscularPrincipal String   @map("grupo_muscular_principal")
  sinergistas            String[] // array de grupos musculares
  descricao              String?  @db.Text
  execucaoTecnica        String?  @map("execucao_tecnica") @db.Text
  errosComuns            String[] @map("erros_comuns")
  imagemUrl              String?  @map("imagem_url")
  cargaInicialSugerida   Float?   @map("carga_inicial_sugerida")
  rpeSugerido            Int?     @map("rpe_sugerido")
  equipamentoNecessario  String[] @map("equipamento_necessario")
  semEquipamento         Boolean  @default(false) @map("sem_equipamento")
  nivelDificuldade       String   @map("nivel_dificuldade") // Iniciante, Intermediário, Avançado
  alternativas           String[] // IDs de exercícios alternativos
  ativo                  Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  exerciciosTreino                ExercicioTreino[]
  templateExercicios              TreinoTemplateExercicio[]
  templatePersonalizadoExercicios TreinoPersonalizadoTemplateExercicio[]
  gruposMusculares                ExercicioGrupoMuscular[]

  @@index([grupoMuscularPrincipal])
  @@index([nivelDificuldade])
  @@index([ativo])
  @@index([grupoMuscularPrincipal, nivelDificuldade, ativo])
  @@index([semEquipamento, ativo])
  @@map("exercicios")
}

model GrupoMuscularVisual {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  slug      String   @unique
  descricao String?
  imagemUrl String?  @map("imagem_url")
  ordem     Int?     @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exercicios ExercicioGrupoMuscular[]

  @@map("grupos_musculares_visuais")
}

model ExercicioGrupoMuscular {
  id            String             @id @default(uuid()) @db.Uuid
  exercicioId   String             @map("exercicio_id")
  grupoVisualId String             @map("grupo_visual_id") @db.Uuid
  papel         PapelGrupoMuscular @default(PRINCIPAL)
  ordem         Int?               @default(0)
  createdAt     DateTime           @default(now()) @map("created_at")

  exercicio Exercicio           @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  grupo     GrupoMuscularVisual @relation(fields: [grupoVisualId], references: [id], onDelete: Cascade)

  @@unique([exercicioId, grupoVisualId, papel])
  @@index([grupoVisualId])
  @@index([exercicioId])
  @@map("exercicios_grupos_musculares")
}

model ExercicioTreino {
  id              String   @id @default(uuid())
  treinoId        String   @map("treino_id")
  exercicioId     String   @map("exercicio_id")
  ordem           Int
  series          Int
  repeticoes      String // pode ser "8-12" ou número fixo
  carga           Float? // em kg
  rpe             Int?
  feedbackSimples String?  @map("feedback_simples") // MUITO_FACIL, NO_PONTO, PESADO_DEMAIS
  aceitouAjuste   Boolean? @map("aceitou_ajuste") // Se usuário aceitou ajuste automático sugerido
  descanso        Int? // em segundos
  concluido       Boolean  @default(false)
  observacoes     String?  @db.Text

  treino    Treino    @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id])

  @@index([treinoId])
  @@index([exercicioId])
  @@index([treinoId, ordem])
  @@map("exercicios_treino")
}

// Template de treino pré-estruturado baseado em objetivos, nível e frequência
model TreinoTemplate {
  id                String   @id @default(uuid())
  nome              String // Ex: "Hipertrofia Iniciante 3x Full Body"
  descricao         String?  @db.Text
  objetivo          String // Hipertrofia, Força, Resistência, Emagrecimento, Condicionamento
  nivelExperiencia  String   @map("nivel_experiencia") // Iniciante, Intermediário, Avançado
  frequenciaSemanal Int      @map("frequencia_semanal") // 2, 3, 4, 5, 6
  divisaoTreino     String   @map("divisao_treino") // Full Body, A-B, A-B-C, A-B-C-D, Push Pull Legs
  diaSemana         Int?     @map("dia_semana") // 1=segunda, 2=terça, etc. (null = qualquer dia)
  gruposMusculares  String[] @map("grupos_musculares") // Grupos trabalhados neste template
  tempoEstimado     Int      @map("tempo_estimado") // em minutos
  volumeTotal       Int?     @map("volume_total") // Total de séries
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  exercicios TreinoTemplateExercicio[]

  @@index([objetivo, nivelExperiencia, frequenciaSemanal])
  @@index([ativo])
  @@map("treino_templates")
}

// Exercícios que compõem um template de treino
model TreinoTemplateExercicio {
  id          String  @id @default(uuid())
  templateId  String  @map("template_id")
  exercicioId String  @map("exercicio_id")
  ordem       Int
  series      Int
  repeticoes  String // pode ser "8-12" ou número fixo
  rpeSugerido Int?    @map("rpe_sugerido")
  descanso    Int? // em segundos
  observacoes String? @db.Text
  obrigatorio Boolean @default(true) // Se false, pode ser substituído por alternativa

  template  TreinoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercicio Exercicio      @relation(fields: [exercicioId], references: [id])

  @@unique([templateId, exercicioId, ordem])
  @@map("treino_template_exercicios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Template de treino personalizado criado pelo usuário
model TreinoPersonalizadoTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  nome      String
  descricao String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercicios TreinoPersonalizadoTemplateExercicio[]
  treinos    Treino[]

  @@map("treino_personalizado_templates")
}

// Exercícios que compõem um template de treino personalizado
model TreinoPersonalizadoTemplateExercicio {
  id          String  @id @default(uuid())
  templateId  String  @map("template_id")
  exercicioId String  @map("exercicio_id")
  ordem       Int
  series      Int
  repeticoes  String // pode ser "8-12" ou número fixo
  carga       Float? // em kg
  descanso    Int? // em segundos
  observacoes String? @db.Text

  template  TreinoPersonalizadoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercicio Exercicio                   @relation(fields: [exercicioId], references: [id])

  @@unique([templateId, exercicioId, ordem])
  @@map("treino_personalizado_template_exercicios")
}

model ConfiguracaoTreinoUsuario {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  diaSemana   Int      @map("dia_semana") // 0=domingo, 1=segunda, etc.
  tipoTreino  String   @map("tipo_treino") // 'IA', 'RECORRENTE'
  letraTreino String?  @map("letra_treino") // A-G (se tipoTreino = 'RECORRENTE')
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, diaSemana])
  @@index([userId])
  @@map("configuracao_treino_usuario")
}

enum Role {
  USER
  ADMIN
}

enum PapelGrupoMuscular {
  PRINCIPAL
  SINERGISTA
}

model PaymentHistory {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  transactionId String   @unique @map("transaction_id") // ID da transação no Cakto
  amount        Float // Valor em reais
  currency      String   @default("BRL")
  status        String // completed, refunded, cancelled
  paymentMethod String?  @map("payment_method")
  caktoData     Json?    @map("cakto_data") // Dados completos do webhook
  plano         String? // MENSAL, TRIMESTRAL, SEMESTRAL
  eventType     String   @map("event_type") // purchase_approved, refund, subscription_cancelled
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@map("payment_history")
}

model TreinoImagemPadrao {
  id        String   @id @default(uuid())
  letra     String   @unique // A, B, C, D, E, F, G
  imagemUrl String   @map("imagem_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("treino_imagens_padrao")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([used])
  @@map("password_reset_tokens")
}

model RemarketingEmail {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tipo      String // '10min', '24h', '48h'
  enviado   Boolean   @default(false)
  dataEnvio DateTime? @map("data_envio")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tipo])
  @@index([userId])
  @@index([tipo])
  @@index([enviado])
  @@index([userId, tipo, enviado])
  @@map("remarketing_emails")
}

model BlogArticle {
  id               String    @id @default(uuid())
  slug             String    @unique
  title            String
  subtitle         String?   @db.Text
  metaTitle        String    @map("meta_title")
  metaDescription  String    @map("meta_description") @db.Text
  keywords         String[] // Array de palavras-chave
  author           String    @default("Equipe AthletIA") // Mantido para compatibilidade
  publishedAt      DateTime? @map("published_at")
  readingTime      Int       @default(0) @map("reading_time") // em minutos
  category         String // Mantido para compatibilidade durante migração
  featuredImage    String?   @map("featured_image")
  featuredImageAlt String?   @map("featured_image_alt")
  excerpt          String    @db.Text
  content          String    @db.Text // Conteúdo em HTML/Markdown
  ctaTitle         String?   @map("cta_title")
  ctaDescription   String?   @map("cta_description") @db.Text
  ctaButtonText    String?   @map("cta_button_text")
  published        Boolean   @default(false)
  isFeatured       Boolean   @default(false) @map("is_featured")
  isPillar         Boolean   @default(false) @map("is_pillar")
  viewsCount       Int       @default(0) @map("views_count")
  status           String    @default("draft") // draft, published
  categoryId       String?   @map("category_id")
  authorId         String?   @map("author_id")
  ctaType          String?   @map("cta_type") // cadastro, criar_treino, conhecer_plataforma
  ctaConfigId      String?   @map("cta_config_id")
  relatedPosts     String[]  @map("related_posts") // Array de IDs de posts relacionados
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relacionamentos
  categoryRelation BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorRelation   BlogAuthor?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  ctaConfig        BlogCTA?      @relation(fields: [ctaConfigId], references: [id], onDelete: SetNull)
  heroSettings     BlogSettings? @relation("BlogHeroPost")

  @@index([slug])
  @@index([published])
  @@index([category])
  @@index([publishedAt])
  @@index([published, publishedAt])
  @@index([isFeatured])
  @@index([isPillar])
  @@index([viewsCount])
  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([published, isFeatured])
  @@index([published, isPillar])
  @@map("blog_articles")
}

model BlogCategory {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text // SEO
  introText       String?  @map("intro_text") @db.Text // Editorial
  icon            String?
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  articles BlogArticle[]

  @@index([slug])
  @@map("blog_categories")
}

model BlogAuthor {
  id           String   @id @default(uuid())
  name         String
  role         String? // Especialidade
  bio          String?  @db.Text
  avatar       String?
  externalLink String?  @map("external_link")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  articles BlogArticle[]

  @@map("blog_authors")
}

model BlogCTA {
  id          String   @id @default(uuid())
  name        String // Nome interno
  type        String // cadastro, criar_treino, conhecer_plataforma
  title       String
  description String   @db.Text
  buttonText  String   @map("button_text")
  link        String
  style       String? // Visual style
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  articles       BlogArticle[]
  globalSettings BlogSettings? @relation("BlogGlobalCTA")

  @@map("blog_ctas")
}

model BlogSettings {
  id                    String   @id @default("global")
  heroPostId            String?  @unique @map("hero_post_id")
  featuredCount         Int      @default(3) @map("featured_count")
  categoriesDisplay     String[] @map("categories_display") // IDs de categorias
  globalCtaId           String?  @unique @map("global_cta_id")
  blogIntroText         String?  @map("blog_intro_text") @db.Text
  globalMetaTitle       String?  @map("global_meta_title")
  globalMetaDescription String?  @map("global_meta_description") @db.Text
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  heroPost  BlogArticle? @relation("BlogHeroPost", fields: [heroPostId], references: [id], onDelete: SetNull)
  globalCta BlogCTA?     @relation("BlogGlobalCTA", fields: [globalCtaId], references: [id], onDelete: SetNull)

  @@map("blog_settings")
}

// WhatsApp Business API Models

model WhatsAppConfig {
  id                 String    @id @default(uuid())
  phoneNumberId      String    @unique @map("phone_number_id") // ID do número na Meta
  phoneNumber        String    @map("phone_number") // Número formatado
  accessToken        String    @map("access_token") // Token de acesso (criptografado)
  webhookVerifyToken String    @map("webhook_verify_token") // Token para verificação de webhook
  businessAccountId  String    @map("business_account_id") // ID da conta business
  appId              String?   @map("app_id") // ID do app Meta
  appSecret          String?   @map("app_secret") // Secret do app (criptografado)
  apiVersion         String    @default("v21.0") @map("api_version")
  isActive           Boolean   @default(false) @map("is_active")
  qualityRating      String?   @map("quality_rating") // GREEN, YELLOW, RED
  qualityScore       Int?      @map("quality_score") // 0-100
  lastHealthCheck    DateTime? @map("last_health_check")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("whatsapp_config")
}

enum WhatsAppConversationStatus {
  open
  closed
  pending
}

model WhatsAppConversation {
  id                String                     @id @default(uuid())
  userId            String?                    @map("user_id")
  phoneNumber       String                     @map("phone_number") // E.164 format
  status            WhatsAppConversationStatus @default(open)
  lastMessageAt     DateTime                   @default(now()) @map("last_message_at")
  lastMessageSentAt DateTime?                  @map("last_message_sent_at")
  messageCount      Int                        @default(0) @map("message_count")
  context           Json? // Contexto da conversa (estado do chatbot)
  optIn             Boolean                    @default(false) @map("opt_in")
  optInDate         DateTime?                  @map("opt_in_date")
  optOutDate        DateTime?                  @map("opt_out_date")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages WhatsAppMessageLog[]

  @@index([phoneNumber])
  @@index([userId])
  @@index([status])
  @@map("whatsapp_conversations")
}

enum WhatsAppMessageDirection {
  inbound
  outbound
}

enum WhatsAppMessageType {
  text
  template
  image
  document
  interactive
}

enum WhatsAppMessageStatus {
  pending
  sent
  delivered
  read
  failed
}

model WhatsAppMessageLog {
  id             String                   @id @default(uuid())
  userId         String?                  @map("user_id")
  conversationId String?                  @map("conversation_id")
  direction      WhatsAppMessageDirection
  messageId      String                   @unique @map("message_id") // ID da mensagem na Meta
  templateName   String?                  @map("template_name")
  messageType    WhatsAppMessageType      @map("message_type")
  messageBody    String                   @map("message_body") @db.Text
  toPhone        String                   @map("to_phone")
  fromPhone      String                   @map("from_phone")
  status         WhatsAppMessageStatus    @default(pending)
  statusDetails  Json?                    @map("status_details")
  errorCode      Int?                     @map("error_code")
  errorMessage   String?                  @map("error_message")
  metadata       Json?
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationId])
  @@index([messageId])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_message_logs")
}

enum WhatsAppTrialStage {
  D1
  D2
  D3
  EXPIRED
}

model WhatsAppCadence {
  id                   String             @id @default(uuid())
  userId               String             @unique @map("user_id")
  trialStage           WhatsAppTrialStage @map("trial_stage")
  d1Sent               Boolean            @default(false) @map("d1_sent")
  d1SentAt             DateTime?          @map("d1_sent_at")
  d2Sent               Boolean            @default(false) @map("d2_sent")
  d2SentAt             DateTime?          @map("d2_sent_at")
  d3Sent               Boolean            @default(false) @map("d3_sent")
  d3SentAt             DateTime?          @map("d3_sent_at")
  expiredSent          Boolean            @default(false) @map("expired_sent")
  expiredSentAt        DateTime?          @map("expired_sent_at")
  planExpiring3dSent   Boolean            @default(false) @map("plan_expiring_3d_sent")
  planExpiring3dSentAt DateTime?          @map("plan_expiring_3d_sent_at")
  planExpiring1dSent   Boolean            @default(false) @map("plan_expiring_1d_sent")
  planExpiring1dSentAt DateTime?          @map("plan_expiring_1d_sent_at")
  planExpiredSent      Boolean            @default(false) @map("plan_expired_sent")
  planExpiredSentAt    DateTime?          @map("plan_expired_sent_at")
  lastUpdated          DateTime           @default(now()) @updatedAt @map("last_updated")
  createdAt            DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trialStage])
  @@map("whatsapp_cadence")
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminUserId  String   @map("admin_user_id")
  action       String // Tipo de ação (ex: "whatsapp_template_created")
  resourceType String   @map("resource_type") // Tipo de recurso (template, message, config, etc)
  resourceId   String?  @map("resource_id")
  details      Json? // Detalhes da ação (antes/depois, etc)
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
